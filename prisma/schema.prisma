generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType { INCOME EXPENSE TRANSFER }
enum GoalStatus { ACTIVE ARCHIVED USED }
enum NotificationType { GOAL_REACHED GOAL_EXCEEDED GOAL_DEADLINE WALLET_NEGATIVE }

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wallets Wallet[]
  transactions Transaction[]
  goals SavingGoal[]
  contributions SavingContribution[]
  notifications Notification[]
}

model Wallet {
  id String @id @default(cuid())
  userId String
  name String @db.VarChar(50)
  balance Decimal @default(0) @db.Decimal(14, 0)
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  incomingTransfers Transaction[] @relation("TransferDestination")
  contributions SavingContribution[]
  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id String @id @default(cuid())
  userId String
  type TransactionType
  amount Decimal @db.Decimal(14, 0)
  category String @db.VarChar(40)
  walletId String
  destinationWalletId String?
  date DateTime
  note String? @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  destinationWallet Wallet? @relation("TransferDestination", fields: [destinationWalletId], references: [id], onDelete: Restrict)
  @@index([userId, date])
  @@index([walletId])
}

model SavingGoal {
  id String @id @default(cuid())
  userId String
  name String @db.VarChar(50)
  targetAmount Decimal @db.Decimal(14, 0)
  targetDate DateTime?
  description String? @db.VarChar(500)
  status GoalStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingContribution[]
  @@index([userId, status])
}

model SavingContribution {
  id String @id @default(cuid())
  goalId String
  walletId String
  userId String
  amount Decimal @db.Decimal(14, 0)
  date DateTime
  note String? @db.VarChar(200)
  createdAt DateTime @default(now())
  goal SavingGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, date])
}

model Notification {
  id String @id @default(cuid())
  userId String
  eventKey String
  type NotificationType
  title String
  message String
  referenceType String?
  referenceId String?
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, eventKey])
  @@index([userId, readAt])
}
